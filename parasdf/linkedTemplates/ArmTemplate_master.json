{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "parasdf"
		},
		"AzureDataLakeStoragedatalakelink_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStoragedatalakelink'"
		},
		"FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileServer1'"
		},
		"files_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'files'"
		},
		"AzureDataLakeStoragedatalakelink_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://parasfirstsa.dfs.core.windows.net/"
		},
		"FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "/Users/macapplwbook/Downloads/CRM+Sales+Opportunities"
		},
		"FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "macapplwbook"
		},
		"HttpServerlinkservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"files_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "/Users/macapplwbook/Downloads/CRM+Sales+Opportunities"
		},
		"files_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "macapplwbook"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "parasdf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStoragedatalakelink_accountKey": {
						"value": "[parameters('AzureDataLakeStoragedatalakelink_accountKey')]"
					},
					"FileServer1_password": {
						"value": "[parameters('FileServer1_password')]"
					},
					"files_password": {
						"value": "[parameters('files_password')]"
					},
					"AzureDataLakeStoragedatalakelink_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStoragedatalakelink_properties_typeProperties_url')]"
					},
					"FileServer1_properties_typeProperties_host": {
						"value": "[parameters('FileServer1_properties_typeProperties_host')]"
					},
					"FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('FileServer1_properties_typeProperties_userId')]"
					},
					"HttpServerlinkservice_properties_typeProperties_url": {
						"value": "[parameters('HttpServerlinkservice_properties_typeProperties_url')]"
					},
					"files_properties_typeProperties_host": {
						"value": "[parameters('files_properties_typeProperties_host')]"
					},
					"files_properties_typeProperties_userId": {
						"value": "[parameters('files_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}